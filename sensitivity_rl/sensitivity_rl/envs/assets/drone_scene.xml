<!--
  Base scene for animate_rollout.py.
  Camera positions, fovy, resolution, and drone bodies are set at runtime by
  the Python script based on the loaded rollout data.  The obstacle and target
  bodies are removed by the script when the data does not contain them.
-->
<mujoco model="drone_replay">
  <compiler angle="radian"/>
  <statistic center="0 0 1" extent="5" meansize="0.05"/>

  <visual>
    <headlight diffuse="0.8 0.8 0.8" ambient="0.6 0.6 0.6" specular="0 0 0"/>
    <rgba haze="1 1 1 1"/>
    <map zfar="200"/>
    <global offwidth="1920" offheight="1080" azimuth="-20" elevation="-20"/>
  </visual>

  <option gravity="0 0 -9.81" timestep="0.005">
    <flag contact="disable" energy="disable"/>
  </option>

  <asset>
    <texture type="skybox" builtin="flat" rgb1="1 1 1" rgb2="1 1 1"
             width="512" height="512"/>
    <!-- mesh path is resolved by passing the file bytes via the assets dict -->
    <mesh name="quadrotor" file="MKQuadro.stl" scale="1 1 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 4" dir="0 0 -1" diffuse="1 1 1" specular="0.2 0.2 0.2"
           directional="true"/>

    <!-- Placeholder positions; overridden at runtime from trajectory data -->
    <camera name="track_side" pos="0 -5 2" xyaxes="1 0 0 0 0.894 0.447"
            mode="fixed"/>
    <camera name="top_down"   pos="0 0 50" xyaxes="1 0 0 0 1 0"
            fovy="5" mode="fixed"/>

    <!-- Optional: removed at runtime if the rollout has no target -->
    <body name="target" mocap="true" pos="0 0 1">
      <geom type="sphere" size="0.08" rgba="0.1 0.8 0.2 0.9"
            contype="0" conaffinity="0"/>
    </body>

    <!-- Optional: removed at runtime if the rollout has no obstacle -->
    <body name="obstacle" mocap="true" pos="0 0 1.5">
      <geom name="obstacle_geom" type="box" size="0.3 0.3 1.5"
            rgba="0.85 0.15 0.15 0.35" contype="0" conaffinity="0"/>
    </body>

    <!-- Drone bodies are added at runtime (count depends on the rollout) -->
  </worldbody>
</mujoco>
