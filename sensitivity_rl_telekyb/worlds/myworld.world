<?xml version="1.0"?>
<sdf version="1.9">
  <world name="mrsim">
    
    <scene>
      <ambient>0.3 0.3 0.3 1.0</ambient>
      <background>0.7 0.8 0.9 1.0</background>
      <shadows>true</shadows>
    </scene>

    <gravity>0 0 -9.81</gravity>
    <magnetic_field>23.816e-6 -0.41e-6 -39.829e-6</magnetic_field>

    <physics name='1ms' type='ignored'>
      <max_step_size>0.002000</max_step_size>
      <real_time_factor>1.000000</real_time_factor>
      <real_time_update_rate>500.000000</real_time_update_rate>
    </physics>

    <light type="directional" name="sun_global">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular> <direction>-0.5 0.5 -0.8</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.2 0.8 0.2 1</ambient>
            <diffuse>0.2 0.8 0.2 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://tilthex-irisa</uri>
      <name>hr6</name>
      <pose>0 0 0.21 0 0 1.5708</pose>
    </include>

    <plugin name="gz::sim::systems::SceneBroadcaster"
            filename="gz-sim-scene-broadcaster-system">
    </plugin>

    <plugin name="optitrack" filename="optitrack-gazebo.so">
      <hz>100</hz>
      <port>1509</port>
      <publish>
        <link>hr6::tilthex_irisa__configuration_default_propellers_false</link>
        <name>HR_6</name>
      </publish>
    </plugin>
  </world>
</sdf>